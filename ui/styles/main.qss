/* ============================================================
   OPTIK — HOME DASHBOARD
   Version: 0.1.0
   ============================================================ */

QFrame#dashboardPanel {
    background-color: #182338;
    border: 1px solid #334155;
    border-radius: 12px;
}

QFrame#featureCard {
    background-color: #182338;
    border: 1px solid #334155;
    border-radius: 12px;
}

QFrame#featureCard:hover {
    border: 1px solid #3b82f6;
}

QLabel#featureTitle {
    color: #f8fafc;
    font-size: 20px;
    font-weight: bold;
}

QLabel#featureDescription {
    color: #94a3b8;
    font-size: 13px;
}

QLabel#sectionTitle {
    color: #f8fafc;
    font-size: 19px;
    font-weight: bold;
}

QLabel#bodyText {
    color: #cbd5e1;
    font-size: 13px;
}

QLabel#dashboardFooter {
    color: #64748b;
    font-size: 12px;
    padding: 12px;
}

/* ============================================================
   OPTIK — SETTINGS
   ============================================================ */

QGroupBox {
    font-size: 14px;
    font-weight: bold;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 10px;
    margin-top: 12px;
    padding: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

QComboBox,
QDoubleSpinBox {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 7px;
    min-height: 24px;
}

QComboBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #3b82f6;
}