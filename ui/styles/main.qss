/* =========================================
   OPTIK — CALCULATOR COMPONENTS
========================================= */

QGroupBox {
    background-color: #111c30;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-top: 12px;
    padding: 15px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 8px;
    color: #38bdf8;
}

QDoubleSpinBox {
    background-color: #1e293b;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 8px;
    color: #f8fafc;
    min-width: 120px;
}

QDoubleSpinBox:focus {
    border: 1px solid #38bdf8;
}

QPushButton#primaryButton {
    background-color: #2563eb;
    border: none;
    border-radius: 6px;
    padding: 12px;
    color: white;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QLabel#resultLabel {
    background-color: #111c30;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 15px;
    font-size: 15px;
}