/* =========================================
   OPTIK — MAIN STYLESHEET
   Version: 0.1.0
========================================= */

QMainWindow {
    background-color: #0b1220;
}

QWidget {
    background-color: #0b1220;
    color: #f8fafc;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* Sidebar */

QWidget#sidebar {
    background-color: #111c30;
    border-right: 1px solid #334155;
}

QLabel#sidebarTitle {
    font-size: 24px;
    font-weight: bold;
    color: #38bdf8;
    padding-bottom: 20px;
}

/* Navigation Buttons */

QWidget#sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;

    text-align: left;
    padding: 12px;
}

QWidget#sidebar QPushButton:hover {
    background-color: #1e293b;
}

QWidget#sidebar QPushButton:checked {
    background-color: #2563eb;
    color: white;
    font-weight: bold;
}

/* Page Titles */

QLabel#pageTitle {
    font-size: 28px;
    font-weight: bold;
    padding: 20px;
}

QLabel#pageSubtitle {
    font-size: 15px;
    color: #94a3b8;
    padding-left: 20px;
}